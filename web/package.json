{
  "name": "support-slot-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Support Slot web companion: promoters post support slots, artists apply, promoters confirm bookings. Runs on local sample data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=esm --outfile=server/dist/server.mjs --log-level=warning",
    "app": "VITE_USE_API=1 vite build && npm run build:server && node server/dist/server.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "@types/node": "^20"
  }
}
