// Copy to Secrets.xcconfig (gitignored) and fill in. Never commit real values.
//
// Supabase dashboard -> Project Settings -> API
//   SUPABASE_HOST     = the Project URL without "https://", e.g. abcdefgh.supabase.co
//   SUPABASE_ANON_KEY = the public "anon" key (row-level security protects the data)
//
// Do NOT put the service-role key in the app. It belongs only in .env.local
// for the demo-data scripts.

SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-key
