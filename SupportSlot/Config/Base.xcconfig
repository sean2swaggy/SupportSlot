// Build settings shared by every configuration.
//
// Your Supabase project goes in Secrets.xcconfig (copy Secrets.example.xcconfig;
// it is gitignored). The host is stored WITHOUT "https://" because xcconfig
// treats "//" as a comment.

SUPABASE_HOST =
SUPABASE_ANON_KEY =

// Optional: overrides the values above.
#include? "Secrets.xcconfig"
