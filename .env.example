# Used only by the scripts in scripts/ (and make-app-config.mjs). Copy to
# .env.local (gitignored) and fill in from Supabase -> Project Settings -> API.
# The names keep the NEXT_PUBLIC_ prefix from the earlier web version.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row-level security. Scripts only — never put it in the app, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
