# Supabase project settings — see Project Settings → API in the Supabase dashboard.
# Copy this file to .env.local and fill in real values. .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses Row Level Security. Never expose to the client,
# never commit. Used only for admin/seed scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site origin (links in emails and auth redirects). Set this to the real
# https origin in production; if unset the request's own origin is used, which
# is fine locally but not something to rely on behind a proxy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the scheduler sends as `Authorization: Bearer <value>` to
# /api/cron/*. Generate a long random string. With it unset, the cron routes
# refuse every request.
CRON_SECRET=

# Optional email provider (Resend). Without these, notification emails stay in
# the outbox and are never reported as sent.
RESEND_API_KEY=
EMAIL_FROM=
